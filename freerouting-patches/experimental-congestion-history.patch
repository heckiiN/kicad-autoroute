+package app.freerouting.autoroute.maze;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+import app.freerouting.geometry.planar.FloatPoint;
+import app.freerouting.geometry.planar.IntBox;
+import org.junit.jupiter.api.Test;
+
+class CongestionHistoryTest {
+
+  private static final IntBox BOARD = new IntBox(0, 0, 64_000, 32_000);
+
+  @Test
+  void createReturnsNullForEmptyArea() {
+    assertNull(CongestionHistory.create(IntBox.EMPTY, 2));
+    assertNull(CongestionHistory.create(BOARD, 0));
+  }
+
+  @Test
+  void recordedContentionIsVisibleOnlyOnItsLayerAndCell() {
+    CongestionHistory history = CongestionHistory.create(BOARD, 2);
+
+    history.recordBox(new IntBox(1_100, 1_100, 1_200, 1_200), 0, 0);
+
+    assertEquals(1.0, history.contentionAt(new FloatPoint(1_150, 1_150), 0));
+    assertEquals(0.0, history.contentionAt(new FloatPoint(1_150, 1_150), 1));
+    assertEquals(0.0, history.contentionAt(new FloatPoint(30_000, 20_000), 0));
+  }
+
+  @Test
+  void contentionAccumulatesAndIsCapped() {
+    CongestionHistory history = CongestionHistory.create(BOARD, 1);
+    IntBox box = new IntBox(10, 10, 20, 20);
+
+    for (int i = 0; i < 100; i++) {
+      history.recordBox(box, 0, 0);
+    }
+
+    assertEquals(
+        CongestionHistory.MAX_EFFECTIVE_CONTENTION,
+        history.contentionAt(new FloatPoint(15, 15), 0));
+    assertEquals(100.0, history.totalContention());
+  }
+
+  @Test
+  void largeBoxesRecordOnlyTheirCentreCell() {
+    CongestionHistory history = CongestionHistory.create(BOARD, 1);
+
+    history.recordBox(BOARD, 0, 0);
+
+    assertEquals(1.0, history.totalContention());
+    assertEquals(1.0, history.contentionAt(new FloatPoint(32_000, 16_000), 0));
+  }
+
+  @Test
+  void pointsOutsideTheBoardClampToTheBorderCells() {
+    CongestionHistory history = CongestionHistory.create(BOARD, 1);
+    history.recordBox(new IntBox(0, 0, 10, 10), 0, 0);
+
+    assertEquals(1.0, history.contentionAt(new FloatPoint(-5_000, -5_000), 0));
+    assertEquals(0.0, history.contentionAt(new FloatPoint(1_000, 1_000), -1));
+  }
+}
