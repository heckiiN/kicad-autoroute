diff --git a/src/main/java/app/freerouting/autoroute/maze/CongestionHistory.java b/src/main/java/app/freerouting/autoroute/maze/CongestionHistory.java
new file mode 100644
index 0000000..565adb1
--- /dev/null
+++ b/src/main/java/app/freerouting/autoroute/maze/CongestionHistory.java
@@ -0,0 +1,144 @@
+package app.freerouting.autoroute.maze;
+
+import app.freerouting.board.model.items.Item;
+import app.freerouting.geometry.planar.FloatPoint;
+import app.freerouting.geometry.planar.IntBox;
+
+/**
+ * Per-layer grid that remembers where connections fought over routing space during earlier
+ * rip-up-and-reroute passes (the "history cost" of the PathFinder negotiated-congestion algorithm).
+ *
+ * <p>Every time an item is ripped up, or a connection fails to route, the cells it covers gain
+ * contention. The maze search then scales the trace cost inside those cells and the rip-up cost of
+ * obstacles lying in them, so nets with a cheap detour move out of contested regions over the
+ * passes and leave them to the nets that have no alternative. The global, pass-number based rip-up
+ * escalation stays unchanged; this only adds a spatial component on top of it.
+ *
+ * <p>The history is updated sequentially by the single-threaded pass loop, so routing stays
+ * deterministic. Costs are only ever increased, which keeps the A* destination estimate a lower
+ * bound.
+ */
+public final class CongestionHistory {
+
+  /** Number of cells along the longer board side. */
+  static final int CELLS_ON_LONG_SIDE = 64;
+
+  /** Upper bound of the contention value used in cost calculations. */
+  static final double MAX_EFFECTIVE_CONTENTION = 16.0;
+
+  /** Items covering more cells than this record their contention only at their centre. */
+  private static final int MAX_CELLS_PER_RECORD = 9;
+
+  private final int minX;
+  private final int minY;
+  private final double cellSize;
+  private final int columns;
+  private final int rows;
+  private final int layerCount;
+  private final float[] contention;
+
+  private CongestionHistory(IntBox area, int layerCount) {
+    this.minX = area.ll.x;
+    this.minY = area.ll.y;
+    int width = Math.max(1, area.ur.x - area.ll.x);
+    int height = Math.max(1, area.ur.y - area.ll.y);
+    this.cellSize = Math.max(1.0, (double) Math.max(width, height) / CELLS_ON_LONG_SIDE);
+    this.columns = Math.max(1, (int) Math.ceil(width / cellSize));
+    this.rows = Math.max(1, (int) Math.ceil(height / cellSize));
+    this.layerCount = Math.max(1, layerCount);
+    this.contention = new float[this.columns * this.rows * this.layerCount];
+  }
+
+  /** Creates an empty history for the board area, or null if the area is empty. */
+  public static CongestionHistory create(IntBox boardArea, int layerCount) {
+    if (boardArea == null || boardArea.isEmpty() || layerCount <= 0) {
+      return null;
+    }
+    return new CongestionHistory(boardArea, layerCount);
+  }
+
+  /** Records one unit of contention for the region and layers occupied by the item. */
+  public void recordItem(Item item) {
+    if (item == null) {
+      return;
+    }
+    IntBox box = item.boundingBox();
+    if (box == null || box.isEmpty()) {
+      return;
+    }
+    recordBox(box, item.firstLayer(), item.lastLayer());
+  }
+
+  /** Records one unit of contention for the box on the layers firstLayer to lastLayer. */
+  public void recordBox(IntBox box, int firstLayer, int lastLayer) {
+    int fromLayer = Math.max(0, firstLayer);
+    int toLayer = Math.min(layerCount - 1, lastLayer);
+    if (fromLayer > toLayer) {
+      return;
+    }
+    int col0 = column(box.ll.x);
+    int col1 = column(box.ur.x);
+    int row0 = row(box.ll.y);
+    int row1 = row(box.ur.y);
+    if ((col1 - col0 + 1) * (row1 - row0 + 1) > MAX_CELLS_PER_RECORD) {
+      col0 = col1 = column((box.ll.x + (double) box.ur.x) / 2);
+      row0 = row1 = row((box.ll.y + (double) box.ur.y) / 2);
+    }
+    for (int layer = fromLayer; layer <= toLayer; layer++) {
+      for (int r = row0; r <= row1; r++) {
+        for (int c = col0; c <= col1; c++) {
+          contention[index(c, r, layer)] += 1.0f;
+        }
+      }
+    }
+  }
+
+  /** Returns the contention at the point on the layer, capped at MAX_EFFECTIVE_CONTENTION. */
+  public double contentionAt(FloatPoint point, int layer) {
+    if (layer < 0 || layer >= layerCount) {
+      return 0.0;
+    }
+    return Math.min(
+        contention[index(column(point.x), row(point.y), layer)], MAX_EFFECTIVE_CONTENTION);
+  }
+
+  /** Returns the highest contention of the item's region, capped at MAX_EFFECTIVE_CONTENTION. */
+  public double contentionOf(Item item) {
+    IntBox box = item.boundingBox();
+    if (box == null || box.isEmpty()) {
+      return 0.0;
+    }
+    FloatPoint centre =
+        new FloatPoint((box.ll.x + (double) box.ur.x) / 2, (box.ll.y + (double) box.ur.y) / 2);
+    double result = 0.0;
+    int fromLayer = Math.max(0, item.firstLayer());
+    int toLayer = Math.min(layerCount - 1, item.lastLayer());
+    for (int layer = fromLayer; layer <= toLayer; layer++) {
+      result = Math.max(result, contentionAt(centre, layer));
+    }
+    return result;
+  }
+
+  /** Returns the sum of all recorded contention; used for diagnostics and tests. */
+  public double totalContention() {
+    double sum = 0.0;
+    for (float value : contention) {
+      sum += value;
+    }
+    return sum;
+  }
+
+  private int column(double x) {
+    int c = (int) Math.floor((x - minX) / cellSize);
+    return Math.clamp(c, 0, columns - 1);
+  }
+
+  private int row(double y) {
+    int r = (int) Math.floor((y - minY) / cellSize);
+    return Math.clamp(r, 0, rows - 1);
+  }
+
+  private int index(int c, int r, int layer) {
+    return (layer * rows + r) * columns + c;
+  }
+}
