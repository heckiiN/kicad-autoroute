+  double congestionFactorOf(Item item) {
+    if (congestionHistory == null || congestionHistoryWeight <= 0.0) {
+      return 1.0;
+    }
+    return 1.0 + congestionHistoryWeight * congestionHistory.contentionOf(item);
+  }
